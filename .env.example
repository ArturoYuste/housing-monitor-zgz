# Copy to .env for local use. Never commit real secrets.

# Idealista / alert emails (pending)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-housing-alerts@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX
IMAP_ENABLED=false

# Optional remote persistence (no Git)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PROPERTIES_TABLE=properties
SUPABASE_CONFIG_TABLE=app_config

# Optional background scans (0 = disabled)
SCAN_INTERVAL_MINUTES=0
